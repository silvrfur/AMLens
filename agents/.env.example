LLM_PROVIDER=azure_openai
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
# Use v1 (or an endpoint ending in /openai/v1/) for the Azure OpenAI v1 API.
AZURE_OPENAI_API_VERSION=2024-10-21
# Leave empty to authenticate with Entra ID (az login locally, managed identity in Azure).
AZURE_OPENAI_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=
DATABASE_URL=sqlite:///./data/synthetic_alerts.db
AZURE_SERVICE_BUS_CONNECTION_STRING=
AZURE_SERVICE_BUS_QUEUE_NAME=
USE_MOCK_LLM=true
USE_MOCK_RAG=true
USE_MOCK_BACKEND=true
USE_MOCK_SERVICE_BUS=true
RAG_SERVICE_URL=
