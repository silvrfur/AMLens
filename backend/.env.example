# Copy to backend/.env (never commit .env). Real environment variables override it.

# --- Main AML data: PostgreSQL ------------------------------------------------
# Use 127.0.0.1, not "localhost": on Windows "localhost" may try IPv6 first,
# which Docker doesn't listen on, adding long connection delays.
# Default: `docker compose up -d` (port 5433 avoids clashing with a local install):
DATABASE_URL=postgresql+psycopg://amlens:amlens_dev@127.0.0.1:5433/amlens
# Locally installed Postgres 16 instead (see README "Local PostgreSQL setup"):
# DATABASE_URL=postgresql+psycopg://amlens:amlens_dev@127.0.0.1:5432/amlens
# Azure Database for PostgreSQL (see DEPLOY_AZURE.md):
# DATABASE_URL=postgresql+psycopg://amlensadmin:<password>@<server>.postgres.database.azure.com:5432/amlens?sslmode=require

# Optional: separate SELECT-only login used by the agent adapter (TeamBackend).
# Defaults to DATABASE_URL; reads are READ ONLY transactions either way.
# AML_SOURCE_DATABASE_URL=postgresql+psycopg://amlens_reader:<password>@127.0.0.1:5433/amlens

# Tests only: throwaway database, name MUST contain "test" (it is wiped).
TEST_DATABASE_URL=postgresql+psycopg://amlens:amlens_dev@127.0.0.1:5433/amlens_test

# --- Account tokenisation (HMAC). >= 32 random chars, keep it stable. ----------
# python -c "import secrets; print(secrets.token_hex(32))"
TOKEN_SECRET=

# --- Agents (member3-agents) ---------------------------------------------------
# Timezone of the IBM source timestamps (they carry none).
AML_SOURCE_TIMEZONE=UTC
# The agents' own runtime store stays SQLite.
AML_AGENT_DATABASE_PATH=./agent_runtime.db
# Deployments: store agent runs in PostgreSQL instead (schema agent_runtime; may be the
# same database as DATABASE_URL). Container disks are wiped on restart, so set this in Azure.
# AML_AGENT_DATABASE_URL=postgresql+psycopg://amlens:amlens_dev@127.0.0.1:5433/amlens
# LLM: mock by default. For Azure OpenAI set USE_MOCK_LLM=false and fill in:
USE_MOCK_LLM=true
LLM_PROVIDER=azure_openai
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_KEY=
# RAG: mock by default. For Member 2's service (run it on port 8001):
USE_MOCK_RAG=true
# RAG_SERVICE_URL=http://127.0.0.1:8001

# --- Frontend ------------------------------------------------------------------
# The frontend reaches this API through its own server-side proxy, so CORS is only
# needed if you point the browser at this API directly (NEXT_PUBLIC_API_BASE_URL).
# AML_CORS_ORIGINS=http://localhost:3000
# Deployments: only accept calls from the frontend proxy. Same value as the
# frontend's AMLENS_PROXY_KEY; >= 32 random chars. Unset = accept all (local dev).
# AML_PROXY_KEY=
